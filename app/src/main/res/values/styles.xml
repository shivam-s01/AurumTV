<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal theme: Compose draws everything, this just needs to be a
         no-actionbar, edge-to-edge base so Compose content isn't fighting
         a system chrome it doesn't use. -->
    <style name="Theme.AurumTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aurum_bg</item>
        <item name="android:colorBackground">@color/aurum_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
