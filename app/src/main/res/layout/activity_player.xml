<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurum_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="48dp">

    <ImageView
        android:id="@+id/player_art"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:scaleType="centerCrop"
        android:background="@color/aurum_card" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aurum_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/aurum_text_secondary"
            android:textSize="20sp" />

        <!-- Playback row: play/pause glyph + progress bar + elapsed/total
             time. D-pad center toggles play/pause (handled in
             PlayerActivity.onKeyDown), left/right seek — this row is purely
             a visual reflection of PlayerViewModel's uiState, no click
             targets of its own, since TV navigation is D-pad-key-driven
             rather than touch-driven. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/player_play_pause_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/player_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/aurum_text_secondary"
                android:textSize="16sp"
                android:text="0:00" />

            <ProgressBar
                android:id="@+id/player_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:max="1000"
                android:progressTint="@color/aurum_gold" />

            <TextView
                android:id="@+id/player_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aurum_text_secondary"
                android:textSize="16sp"
                android:text="0:00" />

        </LinearLayout>

        <TextView
            android:id="@+id/player_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/aurum_text_secondary"
            android:textSize="14sp"
            android:text="OK: Play/Pause    ◀ ▶ : Seek 10s" />

    </LinearLayout>
</LinearLayout>
